# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000
# Public URLs used in emails and referral links
SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
TRUST_PROXY=1

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/grysosta

# ---- Security ----
# Long random string used to hash visitor IP + user agent (never store full IPs)
HASH_SALT=change-me-to-a-long-random-string
# Admin session idle timeout (minutes) and absolute lifetime (hours)
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=24
COOKIE_SECURE=false

# ---- First admin (used by `npm run seed`) ----
ADMIN_EMAIL=admin@grysosta.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Georgino Perez

# ---- Email (Brevo) — leave BREVO_API_KEY empty to log emails to the console ----
BREVO_API_KEY=
EMAIL_FROM_NAME=GRYSOSTA Stock Trading Academy
EMAIL_FROM_ADDRESS=vip@grysosta.com
EMAIL_DAILY_LIMIT=300
EMAIL_BATCH_SIZE=50
EMAIL_WORKER_INTERVAL_SECONDS=10

# ---- Bot protection (Cloudflare Turnstile) — leave empty to disable in development ----
TURNSTILE_SECRET=

# ---- Jobs ----
JOBS_ENABLED=true
JOBS_TIMEZONE=America/Chicago

# ---- Payments (Stripe Checkout for Prepay) — use test keys (sk_test_…) until launch ----
# Empty = Prepay checkout answers 503 "not set up yet" (safe default).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint  <API_URL>/api/v1/public/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.expired, charge.refunded)
STRIPE_WEBHOOK_SECRET=
